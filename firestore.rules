rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /waitlist/{emailHash} {
      allow create: if emailHash.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasAll([
          'email', 'createdAt', 'source', 'privacyVersion'
        ])
        && request.resource.data.keys().hasOnly([
          'email', 'createdAt', 'source', 'privacyVersion'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.createdAt == request.time
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 500
        && request.resource.data.privacyVersion == '1.0';

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
